# ====================================================
# Threads OAuth 設定 (ワンクリックログイン用)
# ====================================================
# Meta for Developers (https://developers.facebook.com/) で
# Threadsアプリを作成して以下の値を取得してください。
#
# 詳しい手順は、アプリ画面の「セットアップガイド」を参照してください。

# Meta開発者ダッシュボード > アプリ設定 > 基本 から取得
THREADS_APP_ID=your_app_id_here
THREADS_APP_SECRET=your_app_secret_here

# OAuth コールバックURL
# Meta側の "Callback URL" 設定にも全く同じ値を登録してください
# 省略可能: 省略時は現在のリクエストホストから自動推測されます
THREADS_REDIRECT_URI=https://your-domain.example.com/api/auth/threads/callback


# ====================================================
# OpenAI (AI変換用) - 既定で GenSpark proxy を使う
# ====================================================
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://www.genspark.ai/api/llm_proxy/v1
